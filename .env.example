# ============================================
# SDWAN智能客服机器人 - 配置文件模板
# ============================================
# 复制此文件为 .env，然后填入实际配置
# ============================================

# -------------------- 模型配置 --------------------
# 主LLM模型配置（Qwen3.8-27B，OpenAI兼容API）
MODEL_API_BASE=http://localhost:11434/v1
MODEL_NAME=qwen2.5:27b
MODEL_API_KEY=sk-xxxxx
TEMPERATURE=0.3
# max_tokens 按路径拆分（2026-10-22）：意图快判与文字生成分开配
DECISION_MAX_TOKENS=256          # 意图快判路径（关思考，JSON输出约56 tokens）
GEN_MAX_TOKENS=1024              # 文字答复生成路径（思考开；思考开+<512会空正文，代码自动抬到512）
DECISION_ENABLE_THINKING=false   # 意图快判关思考（快且省token）
GEN_ENABLE_THINKING=true         # 生成开思考（覆盖知识库全部档位）
# 旧 MAX_TOKENS 已废弃不再单独生效；改名 GEN_MAX_TOKENS

# -------------------- 上下文配置 --------------------
# 保留的对话轮数（每轮=用户1条+助手1条）
CONTEXT_TURNS=10

# -------------------- 等待机制配置 --------------------
# 滑动窗口等待时间（秒）：每收到新消息重置倒计时，停止输入后此时长内汇总回复
WAIT_SLIDE_SECONDS=3
# 最长等待时间（秒）：从首条消息起算的总等待封顶
WAIT_MAX_SECONDS=30
# 会话结束判定（秒）：机器人回复后静默无新消息达到该时长即判会话结束，
# 触发Qwen把整段对话提炼成一问一答追加到data/sdwan-real.md
SESSION_END_SECONDS=20

# -------------------- 知识库配置 --------------------
KNOWLEDGE_BASE_PATH=./data/sdwan.md

# -------------------- 话术配置 --------------------
# 首次对话问候语（会话建立/清空对话时主动推送）
# 多行写法：值必须用英文双引号包住，\n 转义或直接换行均可，例如：
# FIRST_MESSAGE_GREETING="您好，我是SDWAN智能客服机器人。\n很高兴为您服务，请问有什么可以帮您？"
FIRST_MESSAGE_GREETING=您好，我是SDWAN智能客服机器人，很高兴为您服务。
# 无法回答时的话术
NO_ANSWER_MESSAGE=暂时无法回答，需要人工介入

# -------------------- 决策引擎配置 --------------------
# 选择决策引擎: rule / jev / kev / qwen
DECISION_ENGINE=rule

# Jev决策模型配置（System One结构化决策，选择jev时需要）
# 渠道链（2026-10-22 用户定案）：按顺序降级，某渠道失败自动换下一个
JEV_CHANNELS=typesafe,opencode_free,opencode_pay,openrouter
# 每渠道4项：JEV_<NAME大写>_BASE_URL / _ENDPOINT / _MODEL / _API_KEY
# 注意 endpoint 不同：typesafe/opencode 走 /v1/systemone，openrouter 走 /alpha/decisions
JEV_TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_TYPESAFE_ENDPOINT=/v1/systemone
JEV_TYPESAFE_MODEL=jev-latest
JEV_TYPESAFE_API_KEY=
JEV_OPENCODE_FREE_BASE_URL=https://opencode.ai/inference
JEV_OPENCODE_FREE_ENDPOINT=/v1/systemone
JEV_OPENCODE_FREE_MODEL=jev-1.13-free
JEV_OPENCODE_FREE_API_KEY=
JEV_OPENCODE_PAY_BASE_URL=https://opencode.ai/inference
JEV_OPENCODE_PAY_ENDPOINT=/v1/systemone
JEV_OPENCODE_PAY_MODEL=jev-1.13
JEV_OPENCODE_PAY_API_KEY=
JEV_OPENROUTER_BASE_URL=https://openrouter.ai/api
JEV_OPENROUTER_ENDPOINT=/alpha/decisions
JEV_OPENROUTER_MODEL=typesafe/jev-1.13
JEV_OPENROUTER_API_KEY=
# 向后兼容：若上面渠道一个都没配全（key空），回退用下面这组 legacy 单渠道
# （OpenRouter，/alpha/decisions）。渠道链配好后这组可删。
JEV_API_KEY=your-jev-api-key-here
JEV_API_BASE=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13

# Kev模型配置（选择kev时需要）
KEV_MODEL_PATH=tt-hous/kev-0.5b
KEV_DEVICE=cpu  # cpu / cuda:0
# Kev本地serve（真实模型jaredpalmer/kev-0.5b，经kev包kev.serve起本地服务）
# 启动: .venv-kev/Scripts/python -m kev.serve --run runs/kev --port 8009
# 首次加载基座模型需 HF_ENDPOINT=https://hf-mirror.com 和 HF_HOME指向空间充足的盘
KEV_SERVE_URL=http://127.0.0.1:8009
KEV_API_KEY=

# -------------------- 运行时配置 --------------------
# 日志级别 DEBUG / INFO / WARNING / ERROR（日志文件logs/app.log按日期轮转，保留14天）
LOG_LEVEL=INFO
# true=保存对话到JSON文件（调试用）
SAVE_CONVERSATIONS=false

# -------------------- 服务配置 --------------------
HOST=0.0.0.0
PORT=8000
